<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.cdi.uml</groupId>
    <artifactId>cdi-flow-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>cdi-flow (parent)</name>
    <description>
        Portable CDI extension which records call-flows of CDI beans and renders them as
        Mermaid or PlantUML sequence-diagrams.

        A development-tool for running single parts of an application - from a test or by
        triggering one entry-point manually - not for production use.
    </description>

    <url>https://github.com/os890/dynamic-cdi-flow-renderer</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/os890/dynamic-cdi-flow-renderer.git</connection>
        <developerConnection>scm:git:https://github.com/os890/dynamic-cdi-flow-renderer.git</developerConnection>
        <url>https://github.com/os890/dynamic-cdi-flow-renderer</url>
        <tag>HEAD</tag>
    </scm>

    <!--
        The release-target is a git repository served over GitHub Pages rather than a repository
        manager which accepts an upload, so `deploy` writes the Maven layout into a checkout of it
        and that checkout is pushed afterwards. `-Dos890.maven.repo.directory=...` says where it is.
    -->
    <distributionManagement>
        <repository>
            <id>os890-maven-repo</id>
            <name>os890 Maven repository (GitHub Pages)</name>
            <url>file://${os890.maven.repo.directory}</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>dynamic-cdi-flow-renderer</module>
        <module>cdi-flow-lite</module>
        <module>cdi-flow-jaxrs</module>
        <module>cdi-flow-quarkus</module>
        <module>cdi-flow-examples</module>
        <!--
            A module of the root rather than of cdi-flow-examples: the examples there inherit Weld
            and OpenWebBeans as test-dependencies, and this one brings its own container.
        -->
        <module>cdi-flow-examples/cdi-flow-examples-quarkus-crud</module>
        <module>cdi-flow-examples/cdi-flow-examples-jakarta-crud</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <version.cdi.api>4.1.0</version.cdi.api>
        <version.jakarta.rest.api>4.0.0</version.jakarta.rest.api>
        <version.jakarta.annotation.api>3.0.0</version.jakarta.annotation.api>
        <version.quarkus>3.37.4</version.quarkus>
        <version.microprofile.config.api>3.1.1</version.microprofile.config.api>
        <version.smallrye.config>3.16.0</version.smallrye.config>

        <version.weld>6.0.1.Final</version.weld>
        <version.openwebbeans>4.1.0</version.openwebbeans>

        <version.junit>5.12.2</version.junit>
        <version.assertj>3.27.7</version.assertj>

        <version.plugin.compiler>3.14.0</version.plugin.compiler>
        <version.plugin.surefire>3.5.3</version.plugin.surefire>
        <version.plugin.jar>3.4.2</version.plugin.jar>
        <version.plugin.rat>0.18</version.plugin.rat>
        <version.plugin.release>3.0.1</version.plugin.release>
        <version.plugin.source>3.3.1</version.plugin.source>
        <version.plugin.javadoc>3.11.2</version.plugin.javadoc>

        <!-- the checkout of https://github.com/os890/os890-maven-repo a release is written into -->
        <os890.maven.repo.directory>${user.home}/os890-maven-repo</os890.maven.repo.directory>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>dynamic-cdi-flow-renderer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>dynamic-cdi-flow-renderer</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>cdi-flow-lite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>cdi-flow-jaxrs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>cdi-flow-quarkus</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.os890.cdi.uml</groupId>
                <artifactId>cdi-flow-quarkus-deployment</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${version.jakarta.rest.api}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${version.jakarta.annotation.api}</version>
            </dependency>

            <!-- the only two APIs the addon is implemented against -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${version.cdi.api}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${version.microprofile.config.api}</version>
            </dependency>

            <dependency>
                <groupId>io.smallrye.config</groupId>
                <artifactId>smallrye-config</artifactId>
                <version>${version.smallrye.config}</version>
            </dependency>

            <dependency>
                <groupId>org.jboss.weld.se</groupId>
                <artifactId>weld-se-core</artifactId>
                <version>${version.weld}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.openwebbeans</groupId>
                <artifactId>openwebbeans-se</artifactId>
                <version>${version.openwebbeans}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.openwebbeans</groupId>
                <artifactId>openwebbeans-spi</artifactId>
                <version>${version.openwebbeans}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.openwebbeans</groupId>
                <artifactId>openwebbeans-impl</artifactId>
                <version>${version.openwebbeans}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${version.junit}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${version.assertj}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${version.plugin.compiler}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.plugin.surefire}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${version.plugin.jar}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.rat</groupId>
                    <artifactId>apache-rat-plugin</artifactId>
                    <version>${version.plugin.rat}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${version.plugin.source}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${version.plugin.javadoc}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <!--
                    `release:prepare` tags as v<version> - the format the existing v0.1 and v0.2
                    tags use - and `release:perform` builds that tag with the release-profile, so
                    the sources- and javadoc-jars are attached to what is published and to nothing
                    else.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${version.plugin.release}</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <releaseProfiles>release</releaseProfiles>
                    <!-- the examples are demonstrations, and nothing to depend on -->
                    <goals>deploy</goals>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    Guards the Apache-2.0 headers: a source-file without one fails the build in
                    the validate phase, in every module.
                -->
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <!-- the license itself, and files whose format carries no comments -->
                        <exclude>LICENSE</exclude>
                        <exclude>**/*.md</exclude>
                        <exclude>.gitignore</exclude>
                        <exclude>.git/**</exclude>
                        <exclude>.idea/**</exclude>
                        <exclude>.claude/**</exclude>
                        <!-- machine written, and no comment syntax to put a header in -->
                        <exclude>**/pnpm-lock.yaml</exclude>
                        <!-- a list of class-names Quarkus reads; no comment syntax -->
                        <exclude>**/quarkus-build-steps.list</exclude>
                        <exclude>**/node_modules/**</exclude>
                        <exclude>**/dist/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activated by `release:perform` through <releaseProfiles>, so an ordinary build stays as
            quick as it was: generating javadoc for every `mvn install` would cost far more than it
            is worth while nothing is being published.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!--
                                The javadoc is written for a reader, not for the doclint: it links
                                to types of the CDI API which is `provided`, and a missing @param
                                on a self-explaining setter must not fail a release.
                            -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
