<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The root parent, not cdi-flow-examples: the other examples inherit Weld and OpenWebBeans as
        test-dependencies, and this one has a container of its own.
    -->
    <parent>
        <groupId>org.os890.cdi.uml</groupId>
        <artifactId>cdi-flow-parent</artifactId>
        <version>0.9.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cdi-flow-examples-quarkus-crud</artifactId>
    <name>cdi-flow (examples) - quarkus crud</name>
    <description>
        A CRUD application - Quarkus backend, Angular front-end - with the Quarkus extension as its
        only cdi-flow dependency. `./run.sh` drives its use-cases through a browser and the
        application writes a sequence-diagram per use-case while it happens.
    </description>

    <properties>
        <!-- an example demonstrates the addon; it is nothing to depend on, so it is not published -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <quinoa.version>2.8.3</quinoa.version>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            The whole cdi-flow integration of this application: one dependency. No extension class,
            no startup hook, no interceptor-binding in the sources, no include-pattern.
        -->
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>cdi-flow-quarkus</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- serves the Angular bundle from the same process -->
        <dependency>
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${version.quarkus}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
