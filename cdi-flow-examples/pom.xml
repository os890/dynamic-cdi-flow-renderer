<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.cdi.uml</groupId>
        <artifactId>cdi-flow-parent</artifactId>
        <version>0.9.0</version>
    </parent>

    <artifactId>cdi-flow-examples</artifactId>
    <packaging>pom</packaging>
    <name>cdi-flow (examples)</name>
    <description>
        One example-application per configuration. Every example brings its own
        META-INF/microprofile-config.properties, so each of them shows a self-contained,
        realistic setup instead of sharing one configuration with the others.

        All of them run against Weld (-Pweld, the default) and against OpenWebBeans (-Powb).
    </description>

    <modules>
        <module>cdi-flow-examples-beans</module>
        <module>cdi-flow-examples-record-all</module>
        <module>cdi-flow-examples-by-pattern</module>
        <module>cdi-flow-examples-by-stereotype</module>
        <module>cdi-flow-examples-by-pattern-or-stereotype</module>
        <module>cdi-flow-examples-plantuml</module>
        <module>cdi-flow-examples-hotspots</module>
    </modules>

    <properties>
        <!-- an example demonstrates the addon; it is nothing to depend on, so it is not published -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <!-- overwritten by the container profiles, shown in the surefire output -->
        <cdi-flow.container>none</cdi-flow.container>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!-- a real MicroProfile-Config implementation, so the config-part is covered too -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <!-- every test here boots a CDI container -->
                        <include>**/*IT.java</include>
                    </includes>
                    <!--
                        every test-class boots its own SeContainer and resets the static
                        runtime-state afterwards, so a single re-used fork is fine.
                    -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <cdi-flow.test.container>${cdi-flow.container}</cdi-flow.test.container>
                        <cdi-flow.test.output-directory>${project.build.directory}/flow-diagrams/${cdi-flow.container}</cdi-flow.test.output-directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>weld</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <cdi-flow.container>weld</cdi-flow.container>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-core</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>owb</id>
            <properties>
                <cdi-flow.container>owb</cdi-flow.container>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-spi</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-impl</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
